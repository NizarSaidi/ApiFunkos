meta {
  name: Leer Funko
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/funcopops/{{funkoId}}
  body: none
  auth: none
}

tests {
  test("Devuelve los datos actualizados del Funko", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.equal(bru.getVar("funkoId"));
    expect(res.getBody().nombre).to.equal("Bruno Funko actualizado " + bru.getVar("testRunId"));
  });
}
