meta {
  name: Login Admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  const body = res.getBody();
  bru.setVar("adminToken", body.token);
  bru.setVar("testRunId", Date.now().toString());
}

tests {
  test("Devuelve credenciales de un administrador", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("token").that.is.a("string").and.not.empty;
    expect(res.getBody().rol).to.equal("Admin");
  });
}
