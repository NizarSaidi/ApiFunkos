meta {
  name: Listar Proveedores
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/proveedores?page=1
  body: none
  auth: none
}

tests {
  test("Lista proveedores con metadatos de paginación", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data).to.be.an("array");
    expect(res.getBody()).to.have.property("totalCount");
    expect(res.getBody()).to.have.property("totalPages");
  });
}
