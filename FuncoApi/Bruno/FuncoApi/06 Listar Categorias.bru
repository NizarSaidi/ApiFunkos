meta {
  name: Listar Categorias
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/categorias?page=1
  body: none
  auth: none
}

tests {
  test("Lista categorías con metadatos de paginación", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data).to.be.an("array");
    expect(res.getBody()).to.have.property("totalCount");
    expect(res.getBody()).to.have.property("totalPages");
  });
}
